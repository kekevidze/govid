# Copy to .env for local `npm start` (do not commit .env)

PORT=9876
NODE_ENV=development

# Set to false when linking to a partner app (Render production default)
OFFLINE_PRIVACY_MODE=false

# This mirror’s public URL (set on Render to your *.onrender.com URL)
PUBLIC_SITE_URL=https://your-mirror.onrender.com

# Partner project — registration / funnel the CTA opens
PARTNER_APP_URL=https://your-partner-app.onrender.com/register

# Optional partner API (status, eligibility handoff, webhooks)
PARTNER_API_URL=https://your-partner-api.onrender.com

PARTNER_UTM_SOURCE=mygov-mirror
PARTNER_UTM_CAMPAIGN=check-eligibility

# Comma-separated browser origins allowed to call GET /api/integration (defaults include partner URLs)
ALLOWED_PARTNER_ORIGINS=https://your-partner-app.onrender.com
